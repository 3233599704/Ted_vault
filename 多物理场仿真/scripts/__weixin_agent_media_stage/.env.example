# DeepSeek OpenAI-compatible API. The Key can be omitted when it already exists
# in ~/.claude/settings.json as ANTHROPIC_AUTH_TOKEN.
# DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
WEIXIN_CHAT_MODEL=deepseek-v4-flash
WEIXIN_COMPLEX_MODEL=deepseek-v4-pro
MODEL_TIMEOUT_MS=60000
MODEL_MAX_OUTPUT_TOKENS=1800

# Cost and context limits.
WEIXIN_DAILY_TOKEN_LIMIT=500000
WEIXIN_MAX_INPUT_CHARS=12000
WEIXIN_HISTORY_MESSAGES=24
WEIXIN_HISTORY_CHARS=24000

# Weixin API settings. Usually do not change these.
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_BOT_AGENT=VeraAgent/0.6.0
WEIXIN_SEND_TYPING=true
WEIXIN_BURST_QUIET_MS=4000
WEIXIN_RESUME_STABILIZE_MS=8000
WEIXIN_SUSPEND_GAP_MS=90000
WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
WEIXIN_MEDIA_TIMEOUT_MS=30000
WEIXIN_IMAGE_MAX_BYTES=15728640
WEIXIN_VOICE_MAX_BYTES=8388608
WEIXIN_OUTBOUND_IMAGE_MAX_BYTES=8388608
CUSTOM_STICKERS_ENABLED=true
CUSTOM_STICKER_CONTENT_SCALE=0.90
CUSTOM_STICKER_VISUAL_FILL=0.82
CUSTOM_STICKER_CANVAS_SIZE=512

# Comma-separated Agent user IDs. Leave empty only during initial setup, then
# use /whoami and set this value to prevent other contacts from spending quota.
# WEIXIN_ALLOWED_USERS=user-id@im.wechat

# Douyin video understanding. MIMO_API_KEY can be omitted when the existing
# VISION_API_KEY user environment variable is already a Xiaomi MiMo key.
# MIMO_API_KEY=sk-...
MIMO_API_URL=https://api.xiaomimimo.com/v1/chat/completions
MIMO_VIDEO_MODEL=mimo-v2.5
MIMO_VISION_MODEL=mimo-v2.5
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TIMEOUT_MS=180000
DOUYIN_MAX_BYTES=36700160
# DOUYIN_COOKIE_FILE=D:\\Staid\\weixin_agent\\state\\douyin-cookies.txt
# DOUYIN_ARCHIVE_FILE=D:\\Staid\\weixin_agent\\records\\douyin\\抖音视频总结.md
DOUYIN_DEBUG_URL=http://127.0.0.1:9223
DOUYIN_AUTO_SYNC_COOKIES=true
DOUYIN_CHROME_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# DOUYIN_BROWSER_PROFILE=D:\\Staid\\weixin_agent\\state\\douyin-browser

# Background stock jobs.
WEIXIN_PYTHON=py
STOCK_TOOL_TIMEOUT_MS=180000
STOCK_DAILY_DEFAULT_TIME=15:30
